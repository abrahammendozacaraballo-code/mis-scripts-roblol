-- ========== FUNCIONES ==========
local autoActive = false
local spaceActive = false
local godActive = false
local autoConnection = nil
local spaceConnection = nil

local function getNotes()
    local notes = workspace:FindFirstChild("Notes")
    if notes then
        return notes:GetChildren()
    end
    return {}
end

autoBtn.MouseButton1Click:Connect(function()
    autoActive = not autoActive
    if autoActive then
        autoBtn.Text = "ON"
        autoBtn.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
        autoConnection = game:GetService("RunService").RenderStepped:Connect(function()
            if autoActive then
                for _, note in pairs(getNotes()) do
                    if note:IsA("Part") and note:FindFirstChild("ProximityPrompt") then
                        local prompt = note:FindFirstChild("ProximityPrompt")
                        if prompt then
                            fireproximityprompt(prompt)
                        end
                    end
                end
            end
        end)
    else
        autoBtn.Text = "OFF"
        autoBtn.BackgroundColor3 = Color3.fromRGB(80, 60, 140)
        if autoConnection then
            autoConnection:Disconnect()
            autoConnection = nil
        end
    end
end)

spaceBtn.MouseButton1Click:Connect(function()
    spaceActive = not spaceActive
    if spaceActive then
        spaceBtn.Text = "ON"
        spaceBtn.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
        spaceConnection = game:GetService("RunService").RenderStepped:Connect(function()
            if spaceActive then
                local playerGui = player:FindFirstChild("PlayerGui")
                if playerGui then
                    local songSkip = playerGui:FindFirstChild("SongSkip")
                    if songSkip then
                        local skipButton = songSkip:FindFirstChild("SkipButton")
                        if skipButton and skipButton:IsA("TextButton") then
                            skipButton:Click()
                            wait(0.5)
                        end
                    end
                end
            end
        end)
    else
        spaceBtn.Text = "OFF"
        spaceBtn.BackgroundColor3 = Color3.fromRGB(80, 60, 140)
        if spaceConnection then
            spaceConnection:Disconnect()
            spaceConnection = nil
        end
    end
end)

