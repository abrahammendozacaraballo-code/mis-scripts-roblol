local speed = 16
local jump = 50
local infActive = false
local flyActive = false
local noclipActive = false
local hum = nil
local infCon = nil
local noclipCon = nil
local flyParts = {}

local function getHum()
    local char = player.Character
    if char then
        hum = char:FindFirstChild("Humanoid")
        if hum then
            hum.WalkSpeed = speed
            hum.JumpPower = jump
        end
    end
    return hum
end

player.CharacterAdded:Connect(function(char)
    hum = char:WaitForChild("Humanoid")
    hum.WalkSpeed = speed
    hum.JumpPower = jump
end)

speedMinus.MouseButton1Click:Connect(function()
    speed = math.max(16, speed - 5)
    speedVal.Text = tostring(speed)
    if hum then hum.WalkSpeed = speed end
end)

speedPlus.MouseButton1Click:Connect(function()
    speed = math.min(250, speed + 5)
    speedVal.Text = tostring(speed)
    if hum then hum.WalkSpeed = speed end
end)

jumpMinus.MouseButton1Click:Connect(function()
    jump = math.max(50, jump - 10)
    jumpVal.Text = tostring(jump)
    if hum then hum.JumpPower = jump end
end)

jumpPlus.MouseButton1Click:Connect(function()
    jump = math.min(500, jump + 10)
    jumpVal.Text = tostring(jump)
    if hum then hum.JumpPower = jump end
end)

infBtn.MouseButton1Click:Connect(function()
    infActive = not infActive
    if infActive then
        infBtn.Text = "ON"
        infBtn.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
        infCon = game:GetService("UserInputService").JumpRequest:Connect(function()
            if infActive then
                local h = getHum()
                if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
            end
        end)
    else
        infBtn.Text = "OFF"
        infBtn.BackgroundColor3 = Color3.fromRGB(80, 60, 140)
        if infCon then infCon:Disconnect() infCon = nil end
    end
end)

flyBtn.MouseButton1Click:Connect(function()
    flyActive = not flyActive
    if flyActive then
        flyBtn.Text = "ON"
        flyBtn.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
        local char = player.Character
        if char then
            local torso = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
            if torso then
                local bg = Instance.new("BodyGyro")
                local bv = Instance.new("BodyVelocity")
                bg.P = 9e4
                bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
                bg.Parent = torso
                bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                bv.Velocity = Vector3.new(0, 0, 0)
                bv.Parent = torso
                local controls = {W=false, S=false, A=false, D=false, Sp=false, Sh=false}
                local uis = game:GetService("UserInputService")
                local function upd()
                    local vel = Vector3.new(0, 0, 0)
                    if controls.W then vel = vel + torso.CFrame.LookVector end
                    if controls.S then vel = vel - torso.CFrame.LookVector end
                    if controls.D then vel = vel + torso.CFrame.RightVector end
                    if controls.A then vel = vel - torso.CFrame.RightVector end
                    if controls.Sp then vel = vel + Vector3.new(0, 1, 0) end
                    if controls.Sh then vel = vel - Vector3.new(0, 1, 0) end
                    if vel.Magnitude > 0 then vel = vel.Unit * 75 end
                    bv.Velocity = vel
                    if vel.Magnitude > 0 then bg.CFrame = CFrame.new(torso.Position, torso.Position + vel) end
                end
                local c1 = uis.InputBegan:Connect(function(i)
                    local k = i.KeyCode
                    if k == Enum.KeyCode.W then controls.W = true upd() end
                    if k == Enum.KeyCode.S then controls.S = true upd() end
                    if k == Enum.KeyCode.D then controls.D = true upd() end
                    if k == Enum.KeyCode.A then controls.A = true upd() end
                    if k == Enum.KeyCode.Space then controls.Sp = true upd() end
                    if k == Enum.KeyCode.LeftShift then controls.Sh = true upd() end
                end)
                local c2 = uis.InputEnded:Connect(function(i)
                    local k = i.KeyCode
                    if k == Enum.KeyCode.W then controls.W = false upd() end
                    if k == Enum.KeyCode.S then controls.S = false upd() end
                    if k == Enum.KeyCode.D then controls.D = false upd() end
                    if k == Enum.KeyCode.A then controls.A = false upd() end
                    if k == Enum.KeyCode.Space then controls.Sp = false upd() end
                    if k == Enum.KeyCode.LeftShift then controls.Sh = false upd() end
                end)
                local c3 = game:GetService("RunService").Heartbeat:Connect(upd)
                flyParts = {bg, bv, c1, c2, c3}
            end
        end
    else
        flyBtn.Text = "OFF"
        flyBtn.BackgroundColor3 = Color3.fromRGB(60, 100, 140)
        for _, v in pairs(flyParts) do
            if v and v.Disconnect then v:Disconnect()
            elseif v and v.Destroy then v:Destroy() end
        end
        flyParts = {}
    end
end)

noclipBtn.MouseButton1Click:Connect(function()
    noclipActive = not noclipActive
    if noclipActive then
        noclipBtn.Text = "ON"
        noclipBtn.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
        noclipCon = game:GetService("RunService").Stepped:Connect(function()
            if noclipActive then
                local char = player.Character
                if char then
                    for _, p in pairs(char:GetDescendants()) do
                        if p:IsA("BasePart") then p.CanCollide = false end
                    end
                end
            end
        end)
    else
        noclipBtn.Text = "OFF"
        noclipBtn.BackgroundColor3 = Color3.fromRGB(80, 120, 100)
        if noclipCon then noclipCon:Disconnect() noclipCon = nil end
        local char = player.Character
        if char then
            for _, p in pairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = true end
            end
        end
    end
end)

