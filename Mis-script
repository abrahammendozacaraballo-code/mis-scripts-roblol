-- Fly
local flyParts = {}
flyBtn.MouseButton1Click:Connect(function()
    flyActive = not flyActive
    if flyActive then
        flyBtn.Text = "ON"
        flyBtn.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
        
        local char, hum = getChar()
        if char then
            local torso = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
            if torso then
                local bg = Instance.new("BodyGyro")
                local bv = Instance.new("BodyVelocity")
                bg.P = 9e4
                bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
                bg.Parent = torso
                bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                bv.Velocity = Vector3.new(0, 0, 0)
                bv.Parent = torso
                
                local controls = {W=false, S=false, A=false, D=false, Space=false, Shift=false}
                local uis = game:GetService("UserInputService")
                
                local function update()
                    local vel = Vector3.new(0, 0, 0)
                    if controls.W then vel = vel + torso.CFrame.LookVector end
                    if controls.S then vel = vel - torso.CFrame.LookVector end
                    if controls.D then vel = vel + torso.CFrame.RightVector end
                    if controls.A then vel = vel - torso.CFrame.RightVector end
                    if controls.Space then vel = vel + Vector3.new(0, 1, 0) end
                    if controls.Shift then vel = vel - Vector3.new(0, 1, 0) end
                    if vel.Magnitude > 0 then vel = vel.Unit * 75 end
                    bv.Velocity = vel
                    if vel.Magnitude > 0 then
                        bg.CFrame = CFrame.new(torso.Position, torso.Position + vel)
                    end
                end
                
                local con1 = uis.InputBegan:Connect(function(input)
                    local k = input.KeyCode
                    if k == Enum.KeyCode.W then controls.W = true update() end
                    if k == Enum.KeyCode.S then controls.S = true update() end
                    if k == Enum.KeyCode.D then controls.D = true update() end
                    if k == Enum.KeyCode.A then controls.A = true update() end
                    if k == Enum.KeyCode.Space then controls.Space = true update() end
                    if k == Enum.KeyCode.LeftShift then controls.Shift = true update() end
                end)
                
                local con2 = uis.InputEnded:Connect(function(input)
                    local k = input.KeyCode
                    if k == Enum.KeyCode.W then controls.W = false update() end
                    if k == Enum.KeyCode.S then controls.S = false update() end
                    if k == Enum.KeyCode.D then controls.D = false update() end
                    if k == Enum.KeyCode.A then controls.A = false update() end
                    if k == Enum.KeyCode.Space then controls.Space = false update() end
                    if k == Enum.KeyCode.LeftShift then controls.Shift = false update() end
                end)
                
                local con3 = game:GetService("RunService").Heartbeat:Connect(update)
                flyParts = {bg, bv, con1, con2, con3}
            end
        end
    else
        flyBtn.Text = "OFF"
        flyBtn.BackgroundColor3 = Color3.fromRGB(60, 100, 140)
        for _, v in ipairs(flyParts) do
            if v and v.Disconnect then v:Disconnect()
            elseif v and v.Destroy then v:Destroy() end
        end
        flyParts = {}
    end
end)

-- NoClip
local noclipConnection = nil
noclipBtn.MouseButton1Click:Connect(function()
    noclipActive = not noclipActive
    if noclipActive then
        noclipBtn.Text = "ON"
        noclipBtn.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
        noclipConnection = game:GetService("RunService").Stepped:Connect(function()
            if noclipActive then
                local char, _ = getChar()
                if char then
                    for _, part in pairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end
        end)
    else
        noclipBtn.Text = "OFF"
        noclipBtn.BackgroundColor3 = Color3.fromRGB(80, 120, 100)
        if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end
        local char, _ = getChar()
        if char then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
    end
end)

