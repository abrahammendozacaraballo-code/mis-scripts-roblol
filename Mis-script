-- Vuelo
flyBtn.MouseButton1Click:Connect(function()
    volando = not volando
    if volando then
        flyBtn.Text = "🕊️ Fly: ON"
        flyBtn.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
        
        local char = player.Character
        if char then
            local torso = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
            if torso then
                local bg = Instance.new("BodyGyro")
                local bv = Instance.new("BodyVelocity")
                bg.P = 9e4
                bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
                bg.Parent = torso
                bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                bv.Velocity = Vector3.new(0, 0, 0)
                bv.Parent = torso
                
                local controls = {W=false, S=false, A=false, D=false, Space=false, Shift=false}
                local uis = game:GetService("UserInputService")
                
                local function updateFly()
                    local vel = Vector3.new(0, 0, 0)
                    if controls.W then vel = vel + torso.CFrame.LookVector end
                    if controls.S then vel = vel - torso.CFrame.LookVector end
                    if controls.D then vel = vel + torso.CFrame.RightVector end
                    if controls.A then vel = vel - torso.CFrame.RightVector end
                    if controls.Space then vel = vel + Vector3.new(0, 1, 0) end
                    if controls.Shift then vel = vel - Vector3.new(0, 1, 0) end
                    if vel.Magnitude > 0 then vel = vel.Unit * 75 end
                    bv.Velocity = vel
                    if vel.Magnitude > 0 then
                        bg.CFrame = CFrame.new(torso.Position, torso.Position + vel)
                    end
                end
                
                local conBegan = uis.InputBegan:Connect(function(input)
                    local k = input.KeyCode
                    if k == Enum.KeyCode.W then controls.W = true updateFly() end
                    if k == Enum.KeyCode.S then controls.S = true updateFly() end
                    if k == Enum.KeyCode.D then controls.D = true updateFly() end
                    if k == Enum.KeyCode.A then controls.A = true updateFly() end
                    if k == Enum.KeyCode.Space then controls.Space = true updateFly() end
                    if k == Enum.KeyCode.LeftShift then controls.Shift = true updateFly() end
                end)
                
                local conEnded = uis.InputEnded:Connect(function(input)
                    local k = input.KeyCode
                    if k == Enum.KeyCode.W then controls.W = false updateFly() end
                    if k == Enum.KeyCode.S then controls.S = false updateFly() end
                    if k == Enum.KeyCode.D then controls.D = false updateFly() end
                    if k == Enum.KeyCode.A then controls.A = false updateFly() end
                    if k == Enum.KeyCode.Space then controls.Space = false updateFly() end
                    if k == Enum.KeyCode.LeftShift then controls.Shift = false updateFly() end
                end)
                
                local heartbeat = game:GetService("RunService").Heartbeat:Connect(updateFly)
                
                vueloConexiones = {conBegan, conEnded, heartbeat, bg, bv}
            end
        end
    else
        flyBtn.Text = "🕊️ Fly: OFF"
        flyBtn.BackgroundColor3 = Color3.fromRGB(60, 100, 140)
        for _, con in ipairs(vueloConexiones) do
            if con and con.Disconnect then con:Disconnect()
            elseif con and con.Destroy then con:Destroy() end
        end
        vueloConexiones = {}
    end
end)

-- NoClip
noclipBtn.MouseButton1Click:Connect(function()
    noclipActivo = not noclipActivo
    if noclipActivo then
        noclipBtn.Text = "👻 NoClip: ON"
        noclipBtn.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
        noclipConexion = game:GetService("RunService").Stepped:Connect(function()
            if noclipActivo then
                local char = player.Character
                if char then
                    for _, part in pairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end
        end)
    else
        noclipBtn.Text = "👻 NoClip: OFF"
        noclipBtn.BackgroundColor3 = Color3.fromRGB(80, 120, 100)
        if noclipConexion then
            noclipConexion:Disconnect()
            noclipConexion = nil
        end
        local char = player.Character
        if char then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
    end
end)

